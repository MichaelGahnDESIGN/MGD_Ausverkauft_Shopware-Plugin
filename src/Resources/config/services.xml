<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Mgd\SoldOut\Service\GitHubReleaseUpdater"/>

        <service id="Mgd\SoldOut\ScheduledTask\GitHubUpdateCheckTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Mgd\SoldOut\ScheduledTask\GitHubUpdateCheckTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Mgd\SoldOut\Service\GitHubReleaseUpdater"/>
        </service>
    </services>
</container>
