<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <!-- Baukasten aus MichaThemeV5-Pro > src/Kit (bin/build-plugin-kit.php) - Info, Updates, Weitere Plugins, Installation melden -->
    <imports>
        <import resource="../../Kit/Platform/Shopware/Resources/config/services.xml"/>
    </imports>
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <!-- alter GitHub-Update-Check (Updater, Task, Handler) nicht mehr angemeldet, Dateien löschen in der Endversion -->
        <service id="Mgd\SoldOut\Cart\StockThresholdCartValidator">
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="shopware.cart.validator"/>
        </service>
    </services>
</container>
