{% sw_extends '@Storefront/storefront/page/product-detail/buy-widget.html.twig' %}

{% block page_product_detail_buy_container %}
    {% set mgdThresholdEnabled = config('MgdSoldOut.config.thresholdEnabled') %}
    {% set mgdThreshold = mgdThresholdEnabled ? config('MgdSoldOut.config.stockThreshold')|default(0) : 0 %}
    {% set mgdOnlyCloseout = config('MgdSoldOut.config.onlyCloseoutProducts') %}
    {% set mgdSoldOut = page.product.availableStock <= mgdThreshold and (not mgdOnlyCloseout or page.product.isCloseout) %}
    {% set mgdHideBuyArea = config('MgdSoldOut.config.hideBuyArea') %}

    {% if mgdSoldOut %}
        <div class="mgd-soldout-detail" role="status">
            <strong class="mgd-soldout-detail__label">{{ config('MgdSoldOut.config.labelText')|default('Ausverkauft') }}</strong>
            <span class="mgd-soldout-detail__text">{{ config('MgdSoldOut.config.detailText')|default('Dieser Artikel ist aktuell nicht verfügbar.') }}</span>
        </div>
        {% if not mgdHideBuyArea %}
            {{ parent() }}
        {% endif %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
